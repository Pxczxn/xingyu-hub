# ============================================================
# 星语 xingyu-hub .gitignore
#
# 原则：
#   - 默认允许进入 Git：项目源码、正式文档(*.md)、正式脚本(scripts/)、
#     测试代码、数据库 migration(sql/Vxxx__*.sql)、品牌/静态资源
#     (**/public/images/**、**/public/brand/**、**/src/assets/**、**/static/**)
#   - 只忽略：密钥/本地配置、构建产物、依赖、缓存、日志、运行时数据、
#     数据库备份、IDE/OS 垃圾、AI 工具本地数据、原型 QA 临时文件
#   - 不再使用 *.md / /scripts/* 这类过宽规则
#   - 不忽略 .mvn/（Maven Wrapper 需提交）；不全局忽略 *.jar
#   - 不忽略任何 *.sql（sql/Vxxx__*.sql 为正式迁移）
# ============================================================


# ---------- 依赖（凭 lock / pom 恢复） ----------
node_modules/
.npm/
.yarn/
.pnpm-store/
# 注意：.mvn/ 不忽略，未来 Maven Wrapper 需要正常提交
.gradle/


# ---------- 构建产物（凭源码重新生成） ----------
dist/
dist-*/
build/
out/
.next/
.nuxt/
.output/
.vite/
.turbo/
*.tsbuildinfo
*.hprof
*.war
*.ear
*.class
target/
**/target/
vite.config.ts.timestamp-*.mjs


# ---------- 密钥与本地配置（P0） ----------
.env
.env.*
*.env
!.env.example
application-local.yml
application-*-local.yml
application-secret.yml
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ed25519
id_ed25519.*
*.ssh


# ---------- 数据库备份（P1；禁止使用 *.sql） ----------
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.sql.zip
*.sql.bak
*_backup*.sql
*_dump*.sql
/database/data/
/database/backup/


# ---------- 运行时与临时文件 ----------
/uploads/
**/runtime/
tmp/
temp/
*.tmp
.tmp-*
*.pid
*.bak
*.swp
*.swo
*~
xingyu-backend/xingyu-starter/src/main/resources/static/


# ---------- 缓存与测试输出 ----------
.cache/
coverage/
playwright-report/
test-results/
reports/
.eslintcache
work/
outputs/


# ---------- 日志 ----------
logs/
*.log


# ---------- IDE ----------
.idea/
.vscode/
*.iml
.classpath
.project
.settings/
.factorypath


# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini


# ---------- AI / Agent 工具本地数据 ----------
.agent/
.agents/
.claude/
.cursor/
.codex/
.codex-mobile-audit/
.reasonix/
.workbuddy/
.workbuddy-ai/
.plan/
.run/
.ai/
ai-notes/
ai-output/
rollout-*.jsonl
.codex-*.png


# ---------- 原型 / QA 临时资产（不波及正式品牌资源） ----------
.prototype-review/
prototype/
prototypes/
prototype-specs/
prototype-assets/
mockup/
wireframe/
figma/
# 验收 / 测试截图（仅按命名匹配，不影响正式品牌/静态资源）
/p1*-smoke*.png
**/*-smoke*.png
**/screenshots/**
# 保护正式品牌 / 静态资源路径（即使上方截图规则命中也不忽略）
!**/public/images/**
!**/public/brand/**
!**/src/assets/**
!**/static/**


# ---------- 本地资料（个人 AI 流程，非项目资产；docs/ 视为正式文档，不再忽略） ----------
# doc/ 不锚定根，忽略任意层级的本地开发资料目录；/docs/ 为正式文档目录，不忽略
doc/
/qa/
/tools/
/ui+layout/
analyze-pages.py
page-analysis.json
page-summaries.txt


# ---------- 项目专属生成目录 ----------
xingyu-uniapp/unpackage/
