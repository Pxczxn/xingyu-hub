# 星语社区前端环境变量配置示例

# ========================================
# 功能开关
# ========================================

# 启用首页 V2 版本
# true: 使用新版首页（home-page-v2）
# false: 使用旧版首页（home-page）
# 默认: false
VITE_USE_V2_HOME=false

# ========================================
# API 配置
# ========================================

# 后端 API 地址
# 开发环境: http://127.0.0.1:7779
# 生产环境: https://api.xingyu.com
VITE_API_TARGET=http://127.0.0.1:7779
